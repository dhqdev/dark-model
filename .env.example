# Copie para .env (docker compose local) ou cadastre estas variáveis na Stack do Portainer.

# --- acesso (obrigatório) ---
APP_USERNAME=admin
APP_PASSWORD=troque-esta-senha

# --- OpenRouter (obrigatório) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Opcional: chave de gerenciamento (Management key) para mostrar o saldo da conta.
# Sem ela, o painel mostra o limite restante da chave (se a chave tiver limite definido).
OPENROUTER_MANAGEMENT_KEY=

# --- banco (docker compose / stack) ---
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# --- recomendado ---
# Assina o cookie de login. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio, é gerado e salvo no volume /data.
APP_SECRET_KEY=
# true quando o acesso é por HTTPS (Traefik/Caddy/Nginx com TLS). Com http://IP:porta deixe false.
COOKIE_SECURE=false
# URL pública (enviada à OpenRouter como identificação do app), ex.: https://studio.seudominio.com
APP_PUBLIC_URL=
APP_PORT=8000

# --- ajustes finos (opcionais) ---
# Vagas simultâneas do worker por tipo de tarefa
WORKER_LANES=llm=2,image=4,tts=3,video=2,cpu=1
# Resolução e fps dos clipes de movimento (IMAGE + MOTION) renderizados com ffmpeg
MOTION_SIZE=1920x1080
MOTION_FPS=30
LOG_LEVEL=INFO
